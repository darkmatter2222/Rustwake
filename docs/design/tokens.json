  "camera": {
    "projection": "orthographic",
    "worldAxes": "X east, Y up, Z south",
    "defaultYaw": 45,
    "defaultElevation": 35.264,
    "elevationMin": 20,
    "elevationMax": 80,
    "zoomMin": 0.2,
    "zoomMax": 12,
    "panExtent": 90,
    "frustumVerticalAtZoom1": 80
  },
  "layout": {
    "initialCells": [
      24,
      24
    ],
    "worldUnitsPerCell": 3.5,
    "phoneCutoffCssPx": 770,
    "compactDesktopCssPx": 1150,
    "minimumTouchTargetCssPx": 44,
    "stripChipMinHeightCssPx": 44,
    "stripMaxWidthCssPx": 760,
    "phoneStripColumns": 7,
    "ledgerListMaxHeight": "32dvh",
    "phonePanelHeight": "46dvh",
    "documentScroll": false,
    "deviceDPRMax": 2,
    "dockSheetBarCssPx": 48,
    "dockSettingsKey": "rustwake:v2:dock-settings",
    "safeAreaInsets": "env(safe-area-inset-*) fed through --sat/--sar/--sab/--sal on every fixed chrome band (viewport-fit=cover)",
    "sheetBottomReserveCssPx": {
      "phone": 96,
      "landscape": 92,
      "desktop": 133
    },
    "sheetMaxHeight": {
      "phone": "max(120px, min(46dvh, 100dvh - 210px - safe-area))",
      "landscape": "max(120px, 100dvh - 160px - safe-area)",
      "desktop": "min(63dvh, 650px)",
      "narrowText": "max(120px, min(38dvh, 100dvh - 288px - safe-area))"
    },
    "narrowTextCutoffCssPx": 359,
    "narrowTextScroll": "strip, camera rail and tool dock scroll horizontally inside their own bands; document never scrolls",
    "sheetCollapse": "48px persistent bar (title + 44px aria-expanded toggle + 44px close); body hidden in place, panel stays mounted, camera/selection/scroll/confirm untouched; preference persists across reload"
  },
  "accessibility": {
    "normalTextContrast": 4.5,
    "largeTextContrast": 3,
    "componentBoundaryContrast": 3,
    "reducedMotion": "preserve meaning and simulation with alternate discrete motion",
    "colorAlone": false
  },
  "semanticUsage": {
    "amber": "build intent, roads, actionable industry",
    "mint": "valid and functioning",
    "rust": "physical industrial body",
    "danger": "blocked/invalid, with text",
    "neutral": "secondary scene/UI"
  },
  "changePolicy": "Source edit + manifest + documentation + screenshot + independent visual review in one PR"
}
